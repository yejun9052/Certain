# 이 파일을 .env 로 복사해 쓰거나, 셸 환경변수로 직접 설정하세요.
# (서버는 .env 를 자동으로 읽지 않습니다. 의존성을 늘리지 않기 위한 선택입니다.)

# HTTP
PORT=3000
HOST=127.0.0.1

# 리버스 프록시(nginx 등) 뒤에 둘 때만 true
TRUST_PROXY=false

# HTTPS 로 서비스할 때 반드시 true. 세션 쿠키에 Secure 속성이 붙습니다.
COOKIE_SECURE=false

# 세션 유효기간(일)
SESSION_TTL_DAYS=30

# 비밀번호 최소 길이. 기존 앱과 맞추기 위해 기본값은 4입니다(8 이상 권장).
PASSWORD_MIN_LENGTH=4

# DB 파일 경로 (기본: data/certain.sqlite)
# DB_PATH=./data/certain.sqlite

# 콘텐츠 파일 경로 (기본: content/content.json)
# CONTENT_PATH=./content/content.json
